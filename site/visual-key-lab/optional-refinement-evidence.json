  "characters": [
    {
      "id": "blade_shape",
      "label": "Leaf blade shape",
      "hint": "Check a fresh blade. Dry or folded tips can look rolled.",
      "options": [
        {
          "id": "flat",
          "label": "Flat / open"
        },
        {
          "id": "folded",
          "label": "Folded in a V"
        },
        {
          "id": "inrolled",
          "label": "Curled inward"
        }
      ]
    },
    {
      "id": "blade_hairs",
      "label": "Leaf blade hairs",
      "hint": "Check the leaf itself, not the joint or the ligule.",
      "options": [
        {
          "id": "base_hairs",
          "label": "Hairs concentrated near the base"
        },
        {
          "id": "blade_hairy",
          "label": "Hairs along the blade"
        }
      ]
    },
    {
      "id": "leaf_base",
      "label": "Leaf base / sheath",
      "hint": "Look where a blade joins its sheath. Ears (auricles) are separate from ligules.",
      "options": [
        {
          "id": "pointed_auricles",
          "label": "Two upright pointed ears"
        },
        {
          "id": "clasping_auricles",
          "label": "Ears wrapping around the stem"
        },
        {
          "id": "compressed_sheath",
          "label": "Flattened / keeled sheath"
        }
      ]
    },
    {
      "id": "stem_nodes",
      "label": "Stem joints",
      "hint": "Find a real joint along the stem, not the leaf collar.",
      "options": [
        {
          "id": "hairy_nodes",
          "label": "Hairs around a stem joint"
        }
      ]
    }
  ],
